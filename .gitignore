.pnp
.pnp.js

# --------------------------------------------------------------------- builds
dist/
build/
.single-build/
.vite/
*.tsbuildinfo

# Portable single-file build — regenerate with `npm run single`
HiveIdle.html

# Retired files kept around rather than deleted
deprecated/

# ----------------------------------------------------- local launcher scripts
# Convenience wrappers for one machine, not repository content. If you ever
# want to share one, force it in with: git add -f "Name.bat"
*.bat
*.cmd
*.ps1

# -------------------------------------------------- AI assistant local state
# Session data, local settings and scratch output from coding assistants.
# None of it means anything on another machine.
.claude/
.claude-code/
.anthropic/
.cursor/
.cursorignore
.aider*
.continue/
.windsurf/
.codeium/
.github/copilot-session*
# Note: CLAUDE.md is deliberately NOT ignored — project instructions are worth
# committing. Uncomment the next line if you would rather keep yours private.
# CLAUDE.md

# Scratch directories these tools and this project tend to leave behind.
# NOTE the spaced variants: Cowork drops screenshots into a folder literally
# called "Claude outputs", which a plain `outputs/` rule does NOT match. The `?`
# matches the space, hyphen or underscore; the second line covers no separator.
[Cc]laude?[Oo]utput*/
[Cc]laude[Oo]utput*/
[Cc]laude?[Ww]orkspace/
[Cc]laude?[Ff]iles/
*[Ss]creenshots/
outputs/
output/
uploads/
scratch/
tmp/
temp/
*.local

# ------------------------------------------------------------ logs and caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.npm/
.eslintcache
coverage/
.nyc_output/

# ------------------------------------------------------ environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# ----------------------------------------------------------- editors & the OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Screenshots the test suites take on their way through. Evidence for a human
# reading a failure, never assertions — so they are regenerated on every run and
# never committed. The suites themselves, in tests/, ARE committed.
tests/.shots/

# The log `npm run check` leaves behind. One run deep, overwritten each time —
# evidence for whoever has to read a failure, never repository content.
check-log.txt
